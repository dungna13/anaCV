# ─── LLM ───
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# ─── API Server ───
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ─── Session ───
SESSION_TTL_HOURS=24
MAX_CONVERSATION_TURNS=50

# ─── Langfuse (Tracing) ───
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── LangSmith (Tracing) ───
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cvhr-agent

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FORMAT=json
